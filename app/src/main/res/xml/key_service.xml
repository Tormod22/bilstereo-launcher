<?xml version="1.0" encoding="utf-8"?>
<!-- Vinduer (flagRetrieveInteractiveWindows + canRetrieveWindowContent): for å kjenne igjen stereoens
     nedtrekksmeny og fanevisning, og for opptaket i «Kartlegg stereoen». Varsel-hendelser bare til opptaket. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents|flagRetrieveInteractiveWindows"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="0"
    android:description="@string/key_service_desc" />
